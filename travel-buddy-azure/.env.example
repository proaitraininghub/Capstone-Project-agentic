# For running on your LAPTOP (inside the app folder). In Azure these come from the Bicep template.

# --- Redis (REQUIRED: the queue, the sessions, the caches and the rate limits all live here) ---
# Laptop with Docker:   docker run -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379/0
# Azure Managed Redis (note: rediss with TWO s, port 10000):
# REDIS_URL=rediss://:YOUR-ACCESS-KEY@YOUR-NAME.REGION.redis.azure.net:10000/0

# --- The model: Option A: Azure AI Foundry (uses az login) ---
AZURE_OPENAI_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-name
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini

# --- The model: Option B: OpenAI key, for testing only ---
# USE_OPENAI=true
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4.1-mini

# --- Tuning (all optional, these are the defaults) ---
# RATE_LIMIT_PER_MINUTE=10     messages per person per minute
# ANSWER_CACHE_TTL=600         seconds to remember an answer to a first question (0 = off)
# WIKI_CACHE_TTL=3600          seconds to remember a Wikipedia result (0 = off)
# SESSION_TTL_SECONDS=3600     a chat is forgotten after this much silence
# MAX_HISTORY_MESSAGES=20      messages kept per chat (sliding window)

# --- Optional: send monitoring data to Application Insights ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
# ENABLE_SENSITIVE_DATA=false
