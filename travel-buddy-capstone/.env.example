# ---------------------------------------------------------------
# CHOOSE ONE OPTION
# ---------------------------------------------------------------

# OPTION B: OpenAI API key (no Azure needed)
# Set this to true to use OpenAI. Set to false (or delete it) to use Azure.
USE_OPENAI=true
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini
# Optional: a second model for step 7's backup agent
# OPENAI_FALLBACK_MODEL=gpt-4.1-nano

# OPTION A: Azure AI Foundry (needs az login)
AZURE_OPENAI_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-name
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
# Optional: a second deployment for step 7's backup agent
# AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-4.1-nano
